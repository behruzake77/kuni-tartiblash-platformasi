# Ordo configuration
# -------------------

# Public site URL (SEO, sitemap, OG absolute URLs)
# NEXT_PUBLIC_SITE_URL=https://ordo.example.com

# Shown on Privacy / Terms contact links
# NEXT_PUBLIC_CONTACT_EMAIL=you@company.com

# Auth mode: local (default) | clerk | supabase
# NEXT_PUBLIC_ORDO_AUTH=local

# Optional external cloud sync (overrides built-in /api/sync)
# NEXT_PUBLIC_ORDO_SYNC_URL=https://your-api.example.com/ordo
# NEXT_PUBLIC_ORDO_SYNC_TOKEN=optional-bearer-token

# Token for built-in /api/sync (recommended in production)
# ORDO_SYNC_TOKEN=change-me-in-production

# Durable multi-instance sync on Vercel/serverless (recommended)
# Create free Redis at https://upstash.com → REST API
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# Clerk (when NEXT_PUBLIC_ORDO_AUTH=clerk)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Supabase (when NEXT_PUBLIC_ORDO_AUTH=supabase)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
